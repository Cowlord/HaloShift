<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HaloShift.SensitivityOverlayWindow"
        Width="360"
        Height="140"
        CanResize="False"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        IsVisible="False"
        Background="#CC111111"
        TransparencyLevelHint="AcrylicBlur">
  <Border Background="#CC111111" CornerRadius="20" Padding="16" BorderBrush="#FF5A5A5A" BorderThickness="1">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
      <TextBlock Name="ValueText"
                 Text="0"
                 Foreground="White"
                 FontSize="42"
                 FontWeight="Bold"
                 HorizontalAlignment="Center"
                 TextAlignment="Center" />
      <TextBlock Text="Mouse sensitivity"
                 Foreground="#FFB0B0B8"
                 FontSize="16"
                 HorizontalAlignment="Center"
                 TextAlignment="Center" />
    </StackPanel>
  </Border>
</Window>
