<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HaloShift.ControlsWindow"
        Title="HaloShift - Controller Mappings"
        Width="900"
        Height="720"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="#FF0D0D0D"
        SystemDecorations="None">
  <Window.Resources>
    <SolidColorBrush x:Key="BgPanel" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="BorderPanel" Color="#FF2A2A2A" />
    <SolidColorBrush x:Key="AccentGreen" Color="#FF22AA22" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FFBBBBBB" />
    <SolidColorBrush x:Key="TextMuted" Color="#FF999999" />
    <SolidColorBrush x:Key="TextFootnote" Color="#FF777777" />

    <ControlTheme x:Key="SectionPanel" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource BgPanel}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderPanel}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="CornerRadius" Value="4" />
    </ControlTheme>

    <ControlTheme x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AccentGreen}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="LetterSpacing" Value="1" />
    </ControlTheme>

    <ControlTheme x:Key="MappingAction" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </ControlTheme>

    <ControlTheme x:Key="MappingLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </ControlTheme>

    <ControlTheme x:Key="MappingFootnote" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextFootnote}" />
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </ControlTheme>

    <ControlTheme x:Key="ButtonIcon" TargetType="Image">
      <Setter Property="Height" Value="28" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </ControlTheme>
  </Window.Resources>

  <Border BorderBrush="{StaticResource AccentGreen}" BorderThickness="2" Background="#FF0D0D0D">
    <Grid RowDefinitions="Auto,*,Auto">
      <Border Grid.Row="0"
              Background="#FF0D0D0D"
              BorderBrush="{StaticResource AccentGreen}"
              BorderThickness="0,0,0,2"
              Padding="20,14"
              PointerPressed="TitleBar_PointerPressed">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="HALOSHIFT"
                       Foreground="{StaticResource AccentGreen}"
                       FontSize="17"
                       FontWeight="Bold"
                       LetterSpacing="1.5"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="VersionText"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="11"
                       VerticalAlignment="Center" />
            <TextBlock Text="Controller Mappings"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />
          </StackPanel>
          <Button Grid.Column="1"
                  Content="✕"
                  Background="Transparent"
                  Foreground="{StaticResource TextMuted}"
                  BorderThickness="0"
                  FontSize="18"
                  Padding="12,0"
                  Click="CloseButton_Click">
            <Button.Styles>
              <Style Selector="Button:pointerover">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
              </Style>
            </Button.Styles>
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="20,16,20,16">
        <Grid RowDefinitions="Auto,*" RowSpacing="12">
          <!-- Top section: 3 columns -->
          <Grid Grid.Row="0" ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <!-- GENERAL -->
            <Border Grid.Column="0" Theme="{StaticResource SectionPanel}">
              <StackPanel Spacing="8">
                <TextBlock Text="GENERAL" Theme="{StaticResource SectionHeader}" />
                <Grid ColumnDefinitions="100,*" Margin="0,0,0,4">
                  <TextBlock Grid.Column="0" Text="View + Menu" Theme="{StaticResource MappingLabel}" />
                  <TextBlock Grid.Column="1" Text="Toggle mode" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" />
                </Grid>
                <TextBlock Text="Press together to switch Controller ↔ Mouse" 
                           Theme="{StaticResource MappingFootnote}" 
                           Margin="0,0,0,0" />
              </StackPanel>
            </Border>

            <!-- MOUSE CONTROLS -->
            <Border Grid.Column="1" Theme="{StaticResource SectionPanel}">
              <StackPanel Spacing="6">
                <TextBlock Text="MOUSE CONTROLS" Theme="{StaticResource SectionHeader}" />
                <Grid ColumnDefinitions="90,*" Margin="0,0,0,2">
                  <TextBlock Grid.Column="0" Text="Left stick" Theme="{StaticResource MappingLabel}" />
                  <TextBlock Grid.Column="1" Text="Move cursor" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" />
                </Grid>
                <Grid ColumnDefinitions="90,*" Margin="0,0,0,2">
                  <TextBlock Grid.Column="0" Text="Right stick" Theme="{StaticResource MappingLabel}" />
                  <TextBlock Grid.Column="1" Text="Scroll wheel" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" />
                </Grid>
                <Grid ColumnDefinitions="90,*" Margin="0,0,0,2">
                  <TextBlock Grid.Column="0" Text="RT (hold)" Theme="{StaticResource MappingLabel}" />
                  <TextBlock Grid.Column="1" Text="Left click" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" />
                </Grid>
                <Grid ColumnDefinitions="90,*" Margin="0,0,0,2">
                  <TextBlock Grid.Column="0" Text="LT (hold)" Theme="{StaticResource MappingLabel}" />
                  <TextBlock Grid.Column="1" Text="Right click" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- FACE BUTTONS -->
            <Border Grid.Column="2" Theme="{StaticResource SectionPanel}">
              <StackPanel Spacing="6">
                <TextBlock Text="FACE BUTTONS" Theme="{StaticResource SectionHeader}" />
                <Grid ColumnDefinitions="32,*" Margin="0,0,0,2">
                  <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/Y_button.png" />
                  <TextBlock Grid.Column="1" Text="Open keyboard" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="32,*" Margin="0,0,0,2">
                  <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/X_button.png" />
                  <TextBlock Grid.Column="1" Text="Escape" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="32,*" Margin="0,0,0,2">
                  <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/B_button.png" />
                  <TextBlock Grid.Column="1" Text="Browser back" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="32,*" Margin="0,0,0,2">
                  <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/A_button.png" />
                  <TextBlock Grid.Column="1" Text="(Reserved)" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" VerticalAlignment="Center" Opacity="0.5" />
                </Grid>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Bottom section: 2 columns -->
          <Grid Grid.Row="1" ColumnDefinitions="1.2*,*" ColumnSpacing="12">
            <!-- VIRTUAL KEYBOARD -->
            <Border Grid.Column="0" Theme="{StaticResource SectionPanel}" BorderBrush="{StaticResource AccentGreen}" BorderThickness="2">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="VIRTUAL KEYBOARD" Theme="{StaticResource SectionHeader}" Margin="0" />
                  <Border Background="#3322AA22" BorderBrush="{StaticResource AccentGreen}" BorderThickness="1" Padding="8,3" VerticalAlignment="Center" CornerRadius="2">
                    <TextBlock Text="WHEN OPEN" Foreground="{StaticResource AccentGreen}" FontSize="9" FontWeight="Bold" LetterSpacing="0.5" />
                  </Border>
                </StackPanel>
                
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                  <StackPanel Grid.Column="0" Spacing="5">
                    <Grid ColumnDefinitions="80,*" Margin="0,0,0,3">
                      <TextBlock Grid.Column="0" Text="D-Pad" Theme="{StaticResource MappingLabel}" />
                      <TextBlock Grid.Column="1" Text="Navigate keys" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" />
                    </Grid>
                    <Grid ColumnDefinitions="80,*" Margin="0,0,0,3">
                      <TextBlock Grid.Column="0" Text="LB" Theme="{StaticResource MappingLabel}" />
                      <TextBlock Grid.Column="1" Text="Toggle symbols" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" />
                    </Grid>
                    <Grid ColumnDefinitions="80,*" Margin="0,0,0,3">
                      <TextBlock Grid.Column="0" Text="RB (hold)" Theme="{StaticResource MappingLabel}" />
                      <TextBlock Grid.Column="1" Text="Arrow keys" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" />
                    </Grid>
                    <Grid ColumnDefinitions="80,*" Margin="0,0,0,3">
                      <TextBlock Grid.Column="0" Text="LB + RB" Theme="{StaticResource MappingLabel}" />
                      <TextBlock Grid.Column="1" Text="Nav cluster" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" />
                    </Grid>
                  </StackPanel>

                  <StackPanel Grid.Column="1" Spacing="5">
                    <Grid ColumnDefinitions="32,*" Margin="0,0,0,3">
                      <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/A_button.png" />
                      <TextBlock Grid.Column="1" Text="Select key" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="32,*" Margin="0,0,0,3">
                      <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/X_button.png" />
                      <TextBlock Grid.Column="1" Text="Backspace" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="32,*" Margin="0,0,0,3">
                      <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/B_button.png" />
                      <TextBlock Grid.Column="1" Text="Close keyboard" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </Grid>
                
                <Border Background="#FF141414" BorderBrush="#FF2A2A2A" BorderThickness="1" Padding="12,10" CornerRadius="3" Margin="0,4,0,0">
                  <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource TextSecondary}">
                    <Run Text="Note: " FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <Run Text="Sticks and triggers remain active for cursor control and mouse buttons" />
                  </TextBlock>
                </Border>
              </StackPanel>
            </Border>

            <!-- SHORTCUTS & SPECIAL -->
            <Border Grid.Column="1" Theme="{StaticResource SectionPanel}">
              <StackPanel Spacing="8">
                <TextBlock Text="SHORTCUTS" Theme="{StaticResource SectionHeader}" />
                
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="90,*" Margin="0,0,0,2">
                    <TextBlock Grid.Column="0" Text="LS click" Theme="{StaticResource MappingLabel}" />
                    <TextBlock Grid.Column="1" Text="Windows key" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" />
                  </Grid>
                  <Grid ColumnDefinitions="90,*" Margin="0,0,0,2">
                    <TextBlock Grid.Column="0" Text="RS click" Theme="{StaticResource MappingLabel}" />
                    <TextBlock Grid.Column="1" Text="F5 (refresh)" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" />
                  </Grid>
                  <Grid ColumnDefinitions="90,*" Margin="0,0,0,2">
                    <TextBlock Grid.Column="0" Text="LB + View" Theme="{StaticResource MappingLabel}" />
                    <TextBlock Grid.Column="1" Text="Show controls" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" />
                  </Grid>
                  <Grid ColumnDefinitions="90,*" Margin="0,0,0,2">
                    <TextBlock Grid.Column="0" Text="LB alone" Theme="{StaticResource MappingLabel}" />
                    <TextBlock Grid.Column="1" Text="F11 fullscreen" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" />
                  </Grid>
                  <Grid ColumnDefinitions="90,*" Margin="0,0,0,2">
                    <TextBlock Grid.Column="0" Text="D-Pad ↑/↓" Theme="{StaticResource MappingLabel}" />
                    <TextBlock Grid.Column="1" Text="Sensitivity" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" />
                  </Grid>
                </StackPanel>

                <TextBlock Text="COMBOS (LT + RT held)" 
                           Foreground="{StaticResource AccentGreen}"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="0,8,0,4"
                           LetterSpacing="0.5" />
                
                <StackPanel Spacing="5">
                  <Grid ColumnDefinitions="32,60,*" Margin="0,0,0,2">
                    <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/X_button.png" />
                    <TextBlock Grid.Column="1" Text="+ X" Theme="{StaticResource MappingLabel}" />
                    <TextBlock Grid.Column="2" Text="Middle click" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Grid>
                  <Grid ColumnDefinitions="32,60,*" Margin="0,0,0,2">
                    <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/A_button.png" />
                    <TextBlock Grid.Column="1" Text="+ A" Theme="{StaticResource MappingLabel}" />
                    <TextBlock Grid.Column="2" Text="Ctrl + W" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Grid>
                  <Grid ColumnDefinitions="32,60,*" Margin="0,0,0,2">
                    <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/B_button.png" />
                    <TextBlock Grid.Column="1" Text="+ B" Theme="{StaticResource MappingLabel}" />
                    <TextBlock Grid.Column="2" Text="Alt + F4" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <Border Grid.Row="2"
              Background="#FF0D0D0D"
              BorderBrush="{StaticResource AccentGreen}"
              BorderThickness="0,2,0,0"
              Padding="20,14">
        <Button Content="CLOSE"
                HorizontalAlignment="Center"
                Width="140"
                Height="42"
                Background="{StaticResource AccentGreen}"
                Foreground="#FF0D0D0D"
                FontWeight="Bold"
                FontSize="13"
                CornerRadius="3"
                Click="CloseButton_Click">
          <Button.Styles>
            <Style Selector="Button:pointerover">
              <Setter Property="Background" Value="#FF2ACC2A" />
            </Style>
          </Button.Styles>
        </Button>
      </Border>
    </Grid>
  </Border>
</Window>
