<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HaloShift.ControlsWindow"
        Title="HaloShift - Controller Mappings"
        Width="780"
        MaxHeight="860"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="#FF0D0D0D"
        SystemDecorations="None">
  <Window.Resources>
    <SolidColorBrush x:Key="BgPanel" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="BorderPanel" Color="#FF333333" />
    <SolidColorBrush x:Key="AccentGreen" Color="#FF22AA22" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FFAAAAAA" />
    <SolidColorBrush x:Key="TextMuted" Color="#FF888888" />
    <SolidColorBrush x:Key="TextFootnote" Color="#FF666666" />

    <ControlTheme x:Key="SectionPanel" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource BgPanel}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderPanel}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="CornerRadius" Value="2" />
    </ControlTheme>

    <ControlTheme x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </ControlTheme>

    <ControlTheme x:Key="MappingAction" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </ControlTheme>

    <ControlTheme x:Key="MappingLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </ControlTheme>

    <ControlTheme x:Key="MappingFootnote" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextFootnote}" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="Margin" Value="0,10,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </ControlTheme>

    <ControlTheme x:Key="ButtonIcon" TargetType="Image">
      <Setter Property="Height" Value="34" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </ControlTheme>
  </Window.Resources>

  <Border BorderBrush="{StaticResource AccentGreen}" BorderThickness="2" Background="#FF0D0D0D">
    <Grid RowDefinitions="Auto,*,Auto">
      <Border Grid.Row="0"
              Background="#FF0D0D0D"
              BorderBrush="{StaticResource AccentGreen}"
              BorderThickness="0,0,0,2"
              Padding="16,12"
              PointerPressed="TitleBar_PointerPressed">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="HALOSHIFT"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="VersionText"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="10"
                       VerticalAlignment="Center" />
          </StackPanel>
          <Button Grid.Column="1"
                  Content="✕"
                  Background="Transparent"
                  Foreground="{StaticResource TextMuted}"
                  BorderThickness="0"
                  Padding="8,0"
                  Click="CloseButton_Click" />
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" Padding="16,14">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">
            <!-- GENERAL -->
            <Border Grid.Column="0" Theme="{StaticResource SectionPanel}">
              <StackPanel Spacing="4">
                <TextBlock Text="GENERAL" Theme="{StaticResource SectionHeader}" />
                <Grid ColumnDefinitions="40,88,*" Margin="0,2">
                  <TextBlock Grid.Column="1" Text="View + Menu" Theme="{StaticResource MappingLabel}" />
                  <TextBlock Grid.Column="2" Text="Toggle Controller ↔ Mouse mode" Theme="{StaticResource MappingAction}" />
                </Grid>
                <TextBlock Text="Press both buttons together" Theme="{StaticResource MappingFootnote}" Margin="40,4,0,0" />
              </StackPanel>
            </Border>

            <!-- MOUSE MODE (face buttons & LB) -->
            <Border Grid.Column="1" Theme="{StaticResource SectionPanel}">
              <StackPanel Spacing="4">
                <TextBlock Text="MOUSE MODE" Theme="{StaticResource SectionHeader}" />
                <TextBlock Text="Keyboard closed · mouse mode active"
                           Foreground="{StaticResource TextFootnote}"
                           FontSize="9"
                           Margin="0,-6,0,6" />

                <Grid ColumnDefinitions="40,88,*" Margin="0,2">
                  <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/Y_button.png" />
                  <!-- <TextBlock Grid.Column="1" Text="Y" Theme="{StaticResource MappingLabel}" /> -->
                  <TextBlock Grid.Column="2" Text="Open virtual keyboard" Theme="{StaticResource MappingAction}" />
                </Grid>
                <Grid ColumnDefinitions="40,88,*" Margin="0,2">
                  <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/X_button.png" />
                  <!-- <TextBlock Grid.Column="1" Text="X" Theme="{StaticResource MappingLabel}" /> -->
                  <TextBlock Grid.Column="2" Text="Escape" Theme="{StaticResource MappingAction}" />
                </Grid>
                <Grid ColumnDefinitions="40,88,*" Margin="0,2">
                  <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/B_button.png" />
                  <!-- <TextBlock Grid.Column="1" Text="B" Theme="{StaticResource MappingLabel}" /> -->
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Browser Back" Theme="{StaticResource MappingAction}" />
                    <TextBlock Text="closes About when open"
                               Foreground="{StaticResource TextFootnote}"
                               FontSize="9"
                               HorizontalAlignment="Right"
                               Margin="0,2,0,0" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="40,88,*" Margin="0,2">
                  <TextBlock Grid.Column="1" Text="LB + View" Theme="{StaticResource MappingLabel}" />
                  <TextBlock Grid.Column="2" Text="Show controls (About)" Theme="{StaticResource MappingAction}" />
                </Grid>
                <Grid ColumnDefinitions="40,88,*" Margin="0,2">
                  <TextBlock Grid.Column="1" Text="LB" Theme="{StaticResource MappingLabel}" />
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="F11 fullscreen" Theme="{StaticResource MappingAction}" />
                    <TextBlock Text="alone · no RB, Y, or View"
                               Foreground="{StaticResource TextFootnote}"
                               FontSize="9"
                               HorizontalAlignment="Right"
                               Margin="0,2,0,0" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- MOUSE MODE (sticks, triggers, d-pad) -->
            <Border Grid.Row="1" Grid.Column="0" Theme="{StaticResource SectionPanel}">
              <StackPanel Spacing="4">
                <TextBlock Text="MOUSE MODE" Theme="{StaticResource SectionHeader}" />
                <TextBlock Text="Pointer &amp; scroll" Foreground="{StaticResource TextFootnote}" FontSize="9" Margin="0,-6,0,6" />

                <Grid ColumnDefinitions="40,88,*" Margin="0,2">
                  <TextBlock Grid.Column="1" Text="Left stick" Theme="{StaticResource MappingLabel}" />
                  <TextBlock Grid.Column="2" Text="Move cursor" Theme="{StaticResource MappingAction}" />
                </Grid>
                <Grid ColumnDefinitions="40,88,*" Margin="0,2">
                  <TextBlock Grid.Column="1" Text="LS click" Theme="{StaticResource MappingLabel}" />
                  <TextBlock Grid.Column="2" Text="Windows key" Theme="{StaticResource MappingAction}" />
                </Grid>
                <Grid ColumnDefinitions="40,88,*" Margin="0,2">
                  <TextBlock Grid.Column="1" Text="Right stick" Theme="{StaticResource MappingLabel}" />
                  <TextBlock Grid.Column="2" Text="Scroll wheel" Theme="{StaticResource MappingAction}" />
                </Grid>
                <Grid ColumnDefinitions="40,88,*" Margin="0,2">
                  <TextBlock Grid.Column="1" Text="RS click" Theme="{StaticResource MappingLabel}" />
                  <TextBlock Grid.Column="2" Text="F5 (refresh)" Theme="{StaticResource MappingAction}" />
                </Grid>
                <Grid ColumnDefinitions="40,88,*" Margin="0,2">
                  <TextBlock Grid.Column="1" Text="RT (hold)" Theme="{StaticResource MappingLabel}" />
                  <TextBlock Grid.Column="2" Text="Left mouse button" Theme="{StaticResource MappingAction}" />
                </Grid>
                <Grid ColumnDefinitions="40,88,*" Margin="0,2">
                  <TextBlock Grid.Column="1" Text="LT (hold)" Theme="{StaticResource MappingLabel}" />
                  <TextBlock Grid.Column="2" Text="Right mouse button" Theme="{StaticResource MappingAction}" />
                </Grid>
                <Grid ColumnDefinitions="40,88,*" Margin="0,2">
                  <TextBlock Grid.Column="1" Text="D-Pad ↑ / ↓" Theme="{StaticResource MappingLabel}" />
                  <TextBlock Grid.Column="2" Text="Increase / decrease sensitivity" Theme="{StaticResource MappingAction}" />
                </Grid>
                <TextBlock Text="Mouse mode only · not while keyboard is open"
                           Theme="{StaticResource MappingFootnote}"
                           Margin="40,6,0,0" />
              </StackPanel>
            </Border>

            <!-- COMBOS -->
            <Border Grid.Row="1" Grid.Column="1" Theme="{StaticResource SectionPanel}">
              <StackPanel Spacing="4">
                <TextBlock Text="COMBOS" Theme="{StaticResource SectionHeader}" />
                <TextBlock Text="Hold LT + RT together" Foreground="{StaticResource TextFootnote}" FontSize="9" Margin="0,-6,0,6" />

                <Grid ColumnDefinitions="40,88,*" Margin="0,2">
                  <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/X_button.png" />
                  <TextBlock Grid.Column="1" Text="LT + RT + X" Theme="{StaticResource MappingLabel}" />
                  <TextBlock Grid.Column="2" Text="Middle click" Theme="{StaticResource MappingAction}" />
                </Grid>
                <Grid ColumnDefinitions="40,88,*" Margin="0,2">
                  <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/A_button.png" />
                  <TextBlock Grid.Column="1" Text="LT + RT + A" Theme="{StaticResource MappingLabel}" />
                  <TextBlock Grid.Column="2" Text="Ctrl + W" Theme="{StaticResource MappingAction}" />
                </Grid>
                <Grid ColumnDefinitions="40,88,*" Margin="0,2">
                  <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/B_button.png" />
                  <TextBlock Grid.Column="1" Text="LT + RT + B" Theme="{StaticResource MappingLabel}" />
                  <TextBlock Grid.Column="2" Text="Alt + F4" Theme="{StaticResource MappingAction}" />
                </Grid>
                <TextBlock Text="Mouse mode only" Theme="{StaticResource MappingFootnote}" Margin="40,6,0,0" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- VIRTUAL KEYBOARD (full width) -->
          <Border Theme="{StaticResource SectionPanel}"
                  BorderBrush="{StaticResource AccentGreen}"
                  BorderThickness="1">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                <TextBlock Text="VIRTUAL KEYBOARD" Theme="{StaticResource SectionHeader}" Margin="0" />
                <Border Background="#3322AA22" BorderBrush="{StaticResource AccentGreen}" BorderThickness="1" Padding="6,2" VerticalAlignment="Center">
                  <TextBlock Text="WHILE OPEN" Foreground="{StaticResource AccentGreen}" FontSize="8" FontWeight="Bold" />
                </Border>
              </StackPanel>
              <TextBlock Text="Overrides face buttons, bumpers, and D-pad · sticks and triggers still control the mouse"
                         Foreground="{StaticResource TextFootnote}"
                         FontSize="9"
                         Margin="0,0,0,8"
                         TextWrapping="Wrap" />

              <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <StackPanel Grid.Column="0" Spacing="4">
                  <Grid ColumnDefinitions="40,72,*" Margin="0,2">
                    <TextBlock Grid.Column="1" Text="D-Pad" Theme="{StaticResource MappingLabel}" />
                    <TextBlock Grid.Column="2"
                               Text="Navigate keys (wraps on rows; ↑ from TAB reaches F-row)"
                               Theme="{StaticResource MappingAction}"
                               HorizontalAlignment="Stretch"
                               TextAlignment="Left" />
                  </Grid>
                  <Grid ColumnDefinitions="40,72,*" Margin="0,2">
                    <TextBlock Grid.Column="1" Text="RB (hold)" Theme="{StaticResource MappingLabel}" />
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Arrow keys" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" />
                      <TextBlock Text="LB not held · brief key highlight"
                                 Foreground="{StaticResource TextFootnote}"
                                 FontSize="9"
                                 Margin="0,2,0,0" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="40,72,*" Margin="0,2">
                    <TextBlock Grid.Column="1" Text="LB + RB" Theme="{StaticResource MappingLabel}" />
                    <TextBlock Grid.Column="2"
                               Text="Toggle nav cluster (press together)"
                               Theme="{StaticResource MappingAction}"
                               HorizontalAlignment="Left"
                               TextAlignment="Left" />
                  </Grid>
                  <TextBlock Text="PRTSC · SCRLK · PAUSE · INS · HOME · PGUP · DEL · END · PGDN"
                             Foreground="{StaticResource TextFootnote}"
                             FontSize="9"
                             Margin="40,0,0,4"
                             TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="40,72,*" Margin="0,2">
                    <TextBlock Grid.Column="1" Text="LB" Theme="{StaticResource MappingLabel}" />
                    <TextBlock Grid.Column="2" Text="Symbols ↔ letters" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" />
                  </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                  <Grid ColumnDefinitions="40,40,*" Margin="0,2">
                    <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/A_button.png" />
                    <!-- <TextBlock Grid.Column="1" Text="A" Theme="{StaticResource MappingLabel}" /> -->
                    <TextBlock Grid.Column="2" Text="Select key" Theme="{StaticResource MappingAction}" />
                  </Grid>
                  <Grid ColumnDefinitions="40,40,*" Margin="0,2">
                    <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/X_button.png" />
                    <TextBlock Grid.Column="1" Text="X" Theme="{StaticResource MappingLabel}" />
                    <TextBlock Grid.Column="2" Text="Backspace" Theme="{StaticResource MappingAction}" />
                  </Grid>
                  <Grid ColumnDefinitions="40,40,*" Margin="0,2">
                    <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/B_button.png" />
                    <!-- <TextBlock Grid.Column="1" Text="B" Theme="{StaticResource MappingLabel}" /> -->
                    <TextBlock Grid.Column="2" Text="Close keyboard" Theme="{StaticResource MappingAction}" />
                  </Grid>
                  <Border Margin="0,10,0,0"
                          Padding="10,8"
                          Background="#FF141414"
                          BorderBrush="#FF333333"
                          BorderThickness="1"
                          CornerRadius="2">
                    <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextSecondary}">
                      <Run Text="Still active: " FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                      <Run Text="left/right stick (cursor &amp; scroll), LT/RT (mouse buttons)" />
                    </TextBlock>
                  </Border>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2"
              Background="#FF0D0D0D"
              BorderBrush="#FF333333"
              BorderThickness="0,1,0,0"
              Padding="16,12">
        <Button Content="CLOSE"
                HorizontalAlignment="Center"
                Width="120"
                Height="40"
                Background="{StaticResource AccentGreen}"
                Foreground="#FF0D0D0D"
                FontWeight="Bold"
                Click="CloseButton_Click" />
      </Border>
    </Grid>
  </Border>
</Window>
