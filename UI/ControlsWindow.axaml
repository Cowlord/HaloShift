<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HaloShift.ControlsWindow"
        Title="HaloShift - Controller Mappings"
        Width="900"
        Height="780"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="#FF0D0D0D"
        SystemDecorations="None"
        RequestedThemeVariant="Dark">
  <Window.Resources>
    <SolidColorBrush x:Key="BgPanel" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="BorderPanel" Color="#FF2A2A2A" />
    <SolidColorBrush x:Key="AccentGreen" Color="#FF22AA22" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FFBBBBBB" />
    <SolidColorBrush x:Key="TextMuted" Color="#FF999999" />
    <SolidColorBrush x:Key="TextFootnote" Color="#FF777777" />

    <ControlTheme x:Key="SectionPanel" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource BgPanel}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderPanel}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="CornerRadius" Value="4" />
    </ControlTheme>

    <ControlTheme x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AccentGreen}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="LetterSpacing" Value="1" />
    </ControlTheme>

    <ControlTheme x:Key="MappingAction" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </ControlTheme>

    <ControlTheme x:Key="MappingLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </ControlTheme>

    <ControlTheme x:Key="MappingFootnote" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextFootnote}" />
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </ControlTheme>

    <ControlTheme x:Key="ButtonIcon" TargetType="Image">
      <Setter Property="Height" Value="28" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </ControlTheme>
  </Window.Resources>

  <Border BorderBrush="{StaticResource AccentGreen}" BorderThickness="2" Background="#FF0D0D0D">
    <Grid RowDefinitions="Auto,*,Auto">
      <Border Grid.Row="0"
              Background="#FF0D0D0D"
              BorderBrush="{StaticResource AccentGreen}"
              BorderThickness="0,0,0,2"
              Padding="20,14"
              PointerPressed="TitleBar_PointerPressed">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="HALOSHIFT"
                       Foreground="{StaticResource AccentGreen}"
                       FontSize="17"
                       FontWeight="Bold"
                       LetterSpacing="1.5"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="VersionText"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="11"
                       VerticalAlignment="Center" />
            <TextBlock Text="Controller Mappings"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />
          </StackPanel>
          <Button Grid.Column="1"
                  Content="✕"
                  Background="Transparent"
                  Foreground="{StaticResource TextMuted}"
                  BorderThickness="0"
                  FontSize="18"
                  Padding="12,0"
                  Click="CloseButton_Click">
            <Button.Styles>
              <Style Selector="Button:pointerover">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
              </Style>
            </Button.Styles>
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="20,16,20,16">
        <Grid RowDefinitions="Auto,1.2*" RowSpacing="12">
          <!-- Top section: 3 columns -->
          <Grid Grid.Row="0" ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <!-- GENERAL -->
            <Border Grid.Column="0" Theme="{StaticResource SectionPanel}">
              <StackPanel Spacing="8">
                <TextBlock Text="GENERAL" Theme="{StaticResource SectionHeader}" />
                <Grid ColumnDefinitions="32,*" Margin="0,0,0,4">
                  <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/View.png" />
                  <TextBlock Grid.Column="1" Text="Hold (0.7s) — Toggle Mode" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- MOUSE CONTROLS -->
            <Border Grid.Column="1" Theme="{StaticResource SectionPanel}">
              <StackPanel Spacing="6">
                <TextBlock Text="MOUSE CONTROLS" Theme="{StaticResource SectionHeader}" />
                <Grid ColumnDefinitions="32,*" Margin="0,0,0,2">
                  <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/Left Stick.png" />
                  <TextBlock Grid.Column="1" Text="Move Cursor" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="32,*" Margin="0,0,0,2">
                  <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/Right Stick.png" />
                  <TextBlock Grid.Column="1" Text="Scroll Wheel" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="32,*" Margin="0,0,0,2">
                  <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/RT.png" />
                  <TextBlock Grid.Column="1" Text="Hold — Left Click" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="32,*" Margin="0,0,0,2">
                  <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/LT.png" />
                  <TextBlock Grid.Column="1" Text="Hold — Right Click" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- FACE BUTTONS -->
            <Border Grid.Column="2" Theme="{StaticResource SectionPanel}">
              <StackPanel Spacing="6">
                <TextBlock Text="FACE BUTTONS" Theme="{StaticResource SectionHeader}" />
                <Grid ColumnDefinitions="32,*" Margin="0,0,0,2">
                  <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/Y_button.png" />
                  <TextBlock Grid.Column="1" Text="Open Keyboard" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="32,*" Margin="0,0,0,2">
                  <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/X_button.png" />
                  <TextBlock Grid.Column="1" Text="Escape" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="32,*" Margin="0,0,0,2">
                  <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/B_button.png" />
                  <TextBlock Grid.Column="1" Text="Browser Back" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="32,*" Margin="0,0,0,2">
                  <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/A_button.png" />
                  <TextBlock Grid.Column="1" Text="(Reserved)" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" TextAlignment="Left" VerticalAlignment="Center" Opacity="0.5" />
                </Grid>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Bottom section: 2 columns -->
          <Grid Grid.Row="1" ColumnDefinitions="1.3*,*" ColumnSpacing="12">
            <!-- VIRTUAL KEYBOARD -->
            <Border Grid.Column="0" Theme="{StaticResource SectionPanel}" BorderBrush="{StaticResource AccentGreen}" BorderThickness="2">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Virtual Keyboard" Theme="{StaticResource SectionHeader}" Margin="0" />
                  <Border Background="#3322AA22" BorderBrush="{StaticResource AccentGreen}" BorderThickness="1" Padding="8,3" VerticalAlignment="Center" CornerRadius="2">
                    <TextBlock Text="When Open" Foreground="{StaticResource AccentGreen}" FontSize="9" FontWeight="Bold" LetterSpacing="0.5" />
                  </Border>
                </StackPanel>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                  <StackPanel Grid.Column="0" Spacing="5">
                    <Grid ColumnDefinitions="32,*" Margin="0,0,0,3">
                      <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/D-Pad.png" />
                      <TextBlock Grid.Column="1" Text="Navigate Keys" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="32,*" Margin="0,0,0,3">
                      <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/LB.png" />
                      <TextBlock Grid.Column="1" Text="Toggle Symbols" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="32,*" Margin="0,0,0,3">
                      <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/RB.png" />
                      <TextBlock Grid.Column="1" Text="Hold — Arrow Keys" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="60,*" Margin="0,0,0,3">
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                        <Image Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/LB.png" />
                        <TextBlock Text="+" Foreground="{StaticResource TextSecondary}" FontSize="10" VerticalAlignment="Center" />
                        <Image Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/RB.png" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="Nav Cluster" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>

                  <StackPanel Grid.Column="1" Spacing="5">
                    <Grid ColumnDefinitions="32,*" Margin="0,0,0,3">
                      <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/A_button.png" />
                      <TextBlock Grid.Column="1" Text="Select Key" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="32,*" Margin="0,0,0,3">
                      <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/X_button.png" />
                      <TextBlock Grid.Column="1" Text="Backspace" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="32,*" Margin="0,0,0,3">
                      <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/B_button.png" />
                      <TextBlock Grid.Column="1" Text="Close Keyboard" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </Grid>

                <Border Background="#FF141414" BorderBrush="#FF2A2A2A" BorderThickness="1" Padding="12,10" CornerRadius="3" Margin="0,4,0,0">
                  <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource TextSecondary}">
                    <Run Text="Note: " FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <Run Text="Sticks and triggers remain active for cursor control and mouse buttons." />
                  </TextBlock>
                </Border>
              </StackPanel>
            </Border>

            <!-- SHORTCUTS & SPECIAL -->
            <Border Grid.Column="1" Theme="{StaticResource SectionPanel}" Padding="16,12,16,10">
              <StackPanel Spacing="6">
                <TextBlock Text="SHORTCUTS" Theme="{StaticResource SectionHeader}" />

                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="32,*" Margin="0,0,0,2">
                    <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/Left Stick.png" />
                    <TextBlock Grid.Column="1" Text="Click — Windows Key" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Grid>
                  <Grid ColumnDefinitions="32,*" Margin="0,0,0,2">
                    <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/Right Stick.png" />
                    <TextBlock Grid.Column="1" Text="Click — F5 (Refresh)" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Grid>
                  <Grid ColumnDefinitions="70,*" Margin="0,0,0,2">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                      <Image Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/LB.png" />
                      <TextBlock Text="+" Foreground="{StaticResource TextSecondary}" FontSize="10" VerticalAlignment="Center" />
                      <Image Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/View.png" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Show Controls" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Grid>
                  <Grid ColumnDefinitions="32,*" Margin="0,0,0,2">
                    <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/LB.png" />
                    <TextBlock Grid.Column="1" Text="Alone — F11 Fullscreen" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Grid>
                  <Grid ColumnDefinitions="32,*" Margin="0,0,0,2">
                    <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/D-Pad.png" />
                    <TextBlock Grid.Column="1" Text="↑/↓ — Adjust Sensitivity" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>

                <TextBlock Text="COMBOS (LT + RT Held)"
                           Foreground="{StaticResource AccentGreen}"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="0,6,0,3"
                           LetterSpacing="0.5" />

                <StackPanel Spacing="3">
                  <Grid ColumnDefinitions="32,60,*" Margin="0,0,0,2">
                    <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/X_button.png" />
                    <TextBlock Grid.Column="2" Text="Middle Click" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Grid>
                  <Grid ColumnDefinitions="32,60,*" Margin="0,0,0,2">
                    <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/A_button.png" />
                    <TextBlock Grid.Column="2" Text="Ctrl + W" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Grid>
                  <Grid ColumnDefinitions="32,60,*" Margin="0,0,0,2">
                    <Image Grid.Column="0" Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/B_button.png" />
                    <TextBlock Grid.Column="2" Text="Alt + F4" Theme="{StaticResource MappingAction}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                  </Grid>
                  <Border Background="#FF141414" BorderBrush="#FF2A2A2A" BorderThickness="1" Padding="8,6" CornerRadius="3" Margin="0,2,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Image Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/LT.png" />
                      <TextBlock Text="+" Foreground="{StaticResource TextSecondary}" FontSize="10" VerticalAlignment="Center" />
                      <Image Theme="{StaticResource ButtonIcon}" Source="avares://HaloShift/assets/RT.png" />
                      <TextBlock Text="(held)" Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <Border Grid.Row="2"
              Background="#FF0D0D0D"
              BorderBrush="{StaticResource AccentGreen}"
              BorderThickness="0,2,0,0"
              Padding="20,10">
        <Grid ColumnDefinitions="*,Auto,*" VerticalAlignment="Center">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <ToggleSwitch x:Name="StartOnBootToggle"
                          OnContent=""
                          OffContent=""
                          VerticalAlignment="Center"
                          IsCheckedChanged="StartOnBootToggle_Changed">
              <ToggleSwitch.Styles>
                <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
                  <Setter Property="Background" Value="{StaticResource AccentGreen}" />
                  <Setter Property="BorderBrush" Value="{StaticResource AccentGreen}" />
                </Style>
                <Style Selector="ToggleSwitch:checked:pointerover /template/ Border#SwitchKnobBounds">
                  <Setter Property="Background" Value="#FF2ACC2A" />
                  <Setter Property="BorderBrush" Value="#FF2ACC2A" />
                </Style>
              </ToggleSwitch.Styles>
            </ToggleSwitch>
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="Start on Boot"
                         Foreground="{StaticResource TextPrimary}"
                         FontSize="12"
                         FontWeight="SemiBold" />
              <TextBlock Text="Launch HaloShift when Windows starts"
                         Foreground="{StaticResource TextMuted}"
                         FontSize="10" />
            </StackPanel>
          </StackPanel>

          <Button Grid.Column="1"
                  Content="CLOSE"
                  HorizontalAlignment="Center"
                  Width="140"
                  Height="42"
                  Background="{StaticResource AccentGreen}"
                  Foreground="#FF0D0D0D"
                  FontWeight="Bold"
                  FontSize="13"
                  CornerRadius="3"
                  Click="CloseButton_Click">
            <Button.Styles>
              <Style Selector="Button:pointerover">
                <Setter Property="Background" Value="#FF2ACC2A" />
              </Style>
            </Button.Styles>
          </Button>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
