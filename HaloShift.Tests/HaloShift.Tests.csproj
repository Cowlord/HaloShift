    <PackageReference Include="SharpDX.XInput" Version="4.2.0" />
    <PackageReference Include="Avalonia" Version="11.*" />
  </ItemGroup>

  <!-- Link source files from the main project for testing -->
  <ItemGroup>
    <Compile Include="..\ModeManager.cs" Link="Linked\ModeManager.cs" />
